{
  "name": "nabungbego-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Saves and loads Kaya's data in a local SQLite file.",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:reset": "node --disable-warning=ExperimentalWarning src/reset.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5"
  }
}
